# Copy to .env and adjust as needed. All values are optional in development.

# Secret used to sign session cookies. MUST be set to a long random value in production.
SECRET_KEY=dev-secret-key-change-me

# Database connection string. Defaults to instance/trackit.sqlite3
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/trackit

# Minimum password length enforced at registration.
PASSWORD_MIN_LENGTH=8

# Send the session cookie over HTTPS only. Enable in production (1).
SESSION_COOKIE_SECURE=0

# Session lifetime in seconds (default: 7 days).
SESSION_LIFETIME_SECONDS=604800

# Set to 1 when the app runs behind a reverse proxy / load balancer.
TRUST_PROXY=0
